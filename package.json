{
  "name": "proxy-reseller-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "check:production": "node --env-file-if-exists=.env scripts/check-production-env.mjs",
    "db:migrate": "node db/migrate.mjs",
    "typecheck": "tsc --noEmit",
    "admin:create": "node --env-file-if-exists=.env scripts/create-admin.mjs",
    "seo:sync": "node --env-file-if-exists=.env scripts/seo-sync.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "dependencies": {
    "@proxies-sx/pool-sdk": "^0.3.0",
    "framer-motion": "^12.38.0",
    "next": "^15.5.25",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^17.5.0",
    "viem": "^2.48.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "postcss": "8.5.28",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
