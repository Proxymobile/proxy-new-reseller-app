@startuml ProxyHub_AuthFlow
!theme plain
skinparam backgroundColor #FAFAFA
skinparam defaultFontName Inter
skinparam defaultFontSize 11
skinparam shadowing false

title Authentication Flows

== Access Code Login ==

actor User as U
participant "Login Page" as LP
participant "NextAuth\nCredentials" as NA
database "PostgreSQL" as DB

U -> LP : Enter access code
LP -> NA : signIn("access-code",\n{ accessCode })
NA -> DB : Check rate limit\n(5 / 15 min)
NA -> DB : SELECT user\nWHERE access_code = $1
NA -> NA : timingSafeEqual()\ncompare codes
NA -> DB : Record attempt\n(success/fail)
NA --> LP : JWT session
LP --> U : Redirect /dashboard

== Wallet Login ==

actor User2 as U2
participant "Login Page" as LP2
participant "MetaMask" as MM
participant "GET\n/api/auth/wallet-challenge" as WC
participant "NextAuth\nCredentials" as NA2
database "PostgreSQL" as DB2

U2 -> LP2 : Click "Wallet Login"
LP2 -> MM : eth_requestAccounts
MM --> LP2 : address
LP2 -> WC : POST { address }
WC -> WC : HMAC sign\n(nonce + address)
WC --> LP2 : { nonce, hmac, message }
LP2 -> MM : personal_sign(message)
MM --> LP2 : signature
LP2 -> NA2 : signIn("wallet",\n{ address, signature,\n  nonce, hmac })
NA2 -> NA2 : Verify HMAC\n(fresh + authentic)
NA2 -> NA2 : viem.verifyMessage()\n(ETH signature)
NA2 -> DB2 : SELECT wallet_links\nWHERE address
NA2 -> DB2 : SELECT user
NA2 --> LP2 : JWT session
LP2 --> U2 : Redirect /dashboard

@enduml


' ============================================================
' PROXY URL GENERATION FLOW
' ============================================================

@startuml ProxyHub_ProxyFlow
!theme plain
skinparam backgroundColor #FAFAFA
skinparam defaultFontName Inter
skinparam defaultFontSize 11
skinparam shadowing false

title Proxy URL Generation & Usage

actor Customer as C
participant "Keys Page\n/dashboard/keys" as KP
participant "GET\n/api/pool/stock" as STOCK
participant "GET\n/api/pool/keys" as KEYS
participant "Proxies.sx\nGateway" as GW

== Load Page ==

C -> KP : Navigate to /dashboard/keys
KP -> KEYS : Fetch PAK data
KEYS --> KP : { key: { id, key: "pak_...",\ntrafficUsedMB, ... },\nproxyUsername: "psx_..." }

KP -> STOCK : Fetch live pool status
STOCK --> KP : { pools: { mbl: { us: 42, de: 18, ... },\npeer: { us: 120, ... } } }

KP -> KP : Render country grid\nwith modem counts

== Generate URLs (Client-Side) ==

C -> KP : Select country=us,\npool=mbl, rot=sticky,\ncount=5
KP -> KP : Build 5 URLs locally:\nhttp://psx_xxx-mbl-us\n-sid-{random}\n-rot-sticky\n:pak_xxx\n@gw.proxies.sx:7000
KP --> C : Display URLs\n+ Copy buttons

== Use Proxy ==

C -> GW : curl -x {proxy_url}\nhttps://target.com
GW -> GW : Authenticate PAK\nRoute to US mobile modem
GW --> C : Response via\nmobile IP

@enduml
