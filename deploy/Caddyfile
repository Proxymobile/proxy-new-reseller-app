# ──────────────────────────────────────────────────────────────
# Production: auto-TLS via Let's Encrypt
# ──────────────────────────────────────────────────────────────

# www → root canonical redirect
www.proxymobile.shop {
	redir https://proxymobile.shop{uri} permanent
}

# Main site (HTTPS, HTTP/2, HSTS)
proxymobile.shop {
	encode gzip zstd
	reverse_proxy app:3000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# Catch-all on HTTP for any other host (direct IP, unknown subdomains) → redirect to canonical HTTPS
:80 {
	redir https://proxymobile.shop{uri} permanent
}
