# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/proxy_reseller

# Auth.js
AUTH_SECRET=generate-a-random-secret-here
AUTH_URL=http://localhost:3000

# Email (dev mode: links print to console if not set)
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=noreply@yourdomain.com

# Proxies.sx — server-side only, NEVER prefix with NEXT_PUBLIC_
PROXIES_SX_API_KEY=psx_your_api_key_here
PROXIES_SX_USERNAME=your_reseller_username

# Stripe
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here

# Admin panel: what Proxies.sx charges you per GB. Enables profit/margin
# figures in /admin. Leave blank to hide them. Currency: USD (default) or EUR —
# EUR is converted daily with the ECB reference rate.
ADMIN_COST_PER_GB=
ADMIN_COST_CURRENCY=USD

# Admin emails (comma-separated)
ADMIN_EMAILS=admin@yourdomain.com

# Optional Google Analytics 4 (public ID; applied at build time)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-KNF0HKV37K
# Optional Google Search Console HTML verification token (build time)
GOOGLE_SITE_VERIFICATION=

# ---------------------------------------------------------------------------
# SEO tracker (/admin/seo) — Google Search Console
# See docs/SEO-TRACKER.md for the service-account setup.
# ---------------------------------------------------------------------------
# The whole service-account key JSON on one line, or base64-encoded.
GSC_SERVICE_ACCOUNT_JSON=
# Property exactly as Search Console spells it. Domain property:
#   sc-domain:proxymobile.shop
# URL-prefix property:
#   https://proxymobile.shop/
GSC_SITE_URL=sc-domain:proxymobile.shop
# Lets a scheduler POST /api/admin/seo/sync without an admin session.
SEO_CRON_SECRET=
# Base URL used by `npm run seo:sync`.
APP_URL=https://proxymobile.shop
